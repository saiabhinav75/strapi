{
  "kind": "collectionType",
  "collectionName": "menusections",
  "info": {
    "displayName": "Menu Section",
    "singularName": "menusection",
    "pluralName": "menusections",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
