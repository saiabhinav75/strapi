    },
    "dishes": {
      "type": "component",
      "component": "default.dish",
      "repeatable": true,
      "required": true
    },
    "menu": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::menu.menu",
      "inversedBy": "menusections"
    },
    "version": {
      "type": "integer"
    }
  }
}
